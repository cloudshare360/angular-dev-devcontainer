{
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "12"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "my-angular5-app/src/app/app.component.ts"
      ]
    },
    "vscode": {
      "extensions": [
        "angular.ng-template"
      ]
    }
  },
  "portsAttributes": {
    "4200": {
      "label": "Angular App",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    4200
  ],
  "remoteUser": "codespace"
}
